{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_PROJECT_ID=\"$PWD\" MEMORY_API_URL=\"http://127.0.0.1:4815\" bash /Users/rodolfo/Developer/memory/hooks/session_start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_PROJECT_ID=\"$PWD\" MEMORY_API_URL=\"http://127.0.0.1:4815\" bash /Users/rodolfo/Developer/memory/hooks/user_prompt_submit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_PROJECT_ID=\"$PWD\" MEMORY_API_URL=\"http://127.0.0.1:4815\" bash /Users/rodolfo/Developer/memory/hooks/session_end.sh"
          }
        ]
      }
    ]
  }
}
