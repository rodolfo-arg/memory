# Runtime
MEMORY_ENV=dev
MEMORY_API_HOST=127.0.0.1
MEMORY_API_PORT=4815
# Set automatically by install.sh — update if you move the repo
MEMORY_DB_PATH=/path/to/memory/data/memory.db
MEMORY_LOG_LEVEL=INFO

# Retrieval defaults
MEMORY_RETRIEVAL_DENSE_K=60
MEMORY_RETRIEVAL_BM25_K=60
MEMORY_RETRIEVAL_FINAL_K=10
MEMORY_RETRIEVAL_DENSE_WEIGHT=0.95
MEMORY_RETRIEVAL_LEXICAL_WEIGHT=1.05
MEMORY_RETRIEVAL_BACKEND=sqlite
MEMORY_QUERY_TOKEN_BUDGET=1800

# Embeddings
# Providers: ollama (default), mock (no-op, fast), openai, tei
MEMORY_EMBEDDING_PROVIDER=ollama
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBED_DISTANCE_METRIC=cosine
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: OpenAI embeddings
MEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_OPENAI_API_KEY=

# Optional: Text Embeddings Inference (TEI)
MEMORY_TEI_BASE_URL=http://127.0.0.1:8080

# Optional: Qdrant vector store
MEMORY_QDRANT_URL=http://127.0.0.1:6333
MEMORY_QDRANT_COLLECTION=memory_chunks
MEMORY_QDRANT_API_KEY=
MEMORY_QDRANT_TIMEOUT_SECONDS=2.5

# Chunker/summarizer versions (do not change unless migrating)
MEMORY_CHUNKER_VERSION=chunker-v1
MEMORY_SUMMARIZER_VERSION=summarizer-v1

# Data lifecycle
MEMORY_EPISODIC_TTL_DAYS=30
MEMORY_WARM_TTL_DAYS=180

# Safety
MEMORY_ENABLE_REDACTION=true
MEMORY_DENYLIST_PATHS=.env,.ssh,id_rsa,id_ed25519
# Set a random token to protect admin endpoints (optional but recommended)
MEMORY_ADMIN_TOKEN=

# Internal
MEMORY_IDEMPOTENCY_TTL_HOURS=72
MEMORY_ENDPOINT_LATENCY_RETENTION_DAYS=7
MEMORY_ENDPOINT_LATENCY_MAX_SAMPLES_PER_ENDPOINT=5000
MEMORY_INGEST_BATCH_MAX_MESSAGES=2000
MEMORY_EMBED_JOB_LEASE_SECONDS=120
MEMORY_WORKER_ID=
